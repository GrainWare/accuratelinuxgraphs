---
import Layout from "../layouts/404.astro";
---

<style>
  .marquee1 {
    display: block;
    width: 100vw;
    height: 100vh;
  }
</style>

<Layout>
  <marquee
    direction="down"
    behavior="alternate"
    scrollamount="25"
    class="marquee1"
  >
    <marquee behavior="alternate" scrollamount="25">
      <img width="250" height="250" src="/assets/img/404.png" alt="404" />
    </marquee>
  </marquee>
</Layout>
