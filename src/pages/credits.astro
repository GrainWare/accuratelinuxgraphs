---
import GraphCredits from "../components/GraphCredits.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/assets/ico/grain.png" />

    <title>credits</title>
  </head>
  <body>
    <div class="container">
      <a href="/">⬅ return ⬅</a>
      <h1>accuracy credits</h1>
      <h2>developers</h2>
      <ul>
        <li>electron271</li>
        <li>userbyte</li>
      </ul>

      <h2>audio</h2>
      <ul>
        <li>music - electron271</li>
        <li>some sound effects - lyon</li>
        <li>free software song - i think RMS?</li>
        <li>
          accurotate song - remixed from{" "}
          <a href="https://opengameart.org/content/extreme-binary-dnb">
            extreme binary dnb by gobusto
          </a>
        </li>
      </ul>

      <h2>assorted bullshit</h2>
      <ul>
        <li>background tux - anna</li>
        <li>
          /field shader - based on{" "}
          <a href="https://www.shadertoy.com/view/Xsf3zX">
            rolling hills by david hoskins
          </a>
        </li>
        <li>suffering with sorting through 20k 88x31 badges - owuh</li>
      </ul>

      <h2>graphs</h2>
      <GraphCredits />
      <sub
        >if you helped out and would like to be credited:<br /> you can contact <a
          href="https://electron271.gay/">electron271</a
        >, <a href="https://userbyte.xyz/">userbyte</a>, or submit a PR on the <a
          href="https://github.com/GrainWare/accuratelinuxgraphs">repo</a
        ></sub
      >
    </div>
  </body>
</html>

<style>
  body {
    background: black;
    color: white;
    font-family: monospace;
    font-size: 1.15em;
  }

  .container {
    margin: 8px;
  }
  a {
    color: white;
  }
  a:visited {
    color: white;
  }
</style>
