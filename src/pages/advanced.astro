---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <style>
    a {
      color: white;
    }

    a:hover {
      color: #e5e100;
    }

    .settings_outer {
      height: 88vh;
      display: flex;
      backdrop-filter: blur(10px);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1em;
      /* padding-top: 10em; */
    }

    .settings_inner {
      transform: scaleX(1.56235787);
      border-radius: 13.28235787%;
      display: flex;
      flex-direction: column;
      backdrop-filter: blur(17px);
      gap: 0.5em;
      width: fit-content;
      padding: 1em 1.5em;
      height: 20em;
      background-color: rgba(80, 69, 18, 0.634);
      border: 2px dashed #e5e100;
    }

    span {
      display: flex;
      justify-content: space-between;
      gap: 0.5em;
      padding-bottom: 0.4em;
      border-bottom: 1px solid white;
    }

    label {
      user-select: none;
      text-shadow: 0 0 8px #fff;
    }
    input {
      background-color: blue;
    }

    label:hover,
    input:hover {
      color: #bca532;
      cursor: pointer;
      text-shadow: 0 0 10px #fffb00;
    }
  </style>
  <script is:inline>
    const defaultSettings = {
      animation: true,
      superGrainMode: false,
      ultraAccurateTechnology: false,
      accuracySong2: false,
    };

    function toggleSetting(settingName) {
      // get the currently stored setting value
      const curValue = localStorage.getItem(`settings_${settingName}`);

      // is it set? if not, set it to the default value
      if (!curValue) {
        // default settings

        localStorage.setItem(
          `settings_${settingName}`,
          defaultSettings[settingName]
        );
        return;
      }

      // flip setting value
      localStorage.setItem(
        `settings_${settingName}`,
        curValue === "true" ? false : true
      );
      console.log(
        `changed ${settingName} from ${curValue} to ${curValue === "true" ? false : true}`
      );
    }

    // onload
    document.addEventListener("DOMContentLoaded", () => {
      // set initial settings
      for (settingName in defaultSettings) {
        // only set if its unset
        if (!localStorage.getItem(`settings_${settingName}`))
          localStorage.setItem(
            `settings_${settingName}`,
            defaultSettings[settingName]
          );

        // make the checkboxes reflect stored settings
        const cbEl = document.querySelector(`[data-setting="${settingName}"]`);

        if (cbEl)
          cbEl.checked =
            localStorage.getItem(`settings_${settingName}`) === "true";
      }
    });
  </script>

  <div class="settings_outer">
    <a href="/">⬅ return ⬅</a>
    <h2>advanced settings</h2>
    <p>
      WARNING: modifying these settings may affect accuracy levels!<br /> positive
      or negative effect? we dont know yet. <i>we simply do NOT know...</i>
    </p>
    <div class="settings_inner">
      <noscript>all this stuff requires javascript to be enabled :P</noscript>
      <span>
        <label for="toggleAnimations">animation</label>
        <input
          type="checkbox"
          id="toggleAnimations"
          data-setting="animation"
          onclick="toggleSetting('animation')"
        />
      </span>
      <span>
        <label for="toggleSGM">SUPER GRAIN MODE</label>
        <input
          type="checkbox"
          id="toggleSGM"
          data-setting="superGrainMode"
          onclick="toggleSetting('superGrainMode')"
        />
      </span>
      <span>
        <label for="toggleUAT">Ultra Accurate Technology</label>
        <input
          type="checkbox"
          id="toggleUAT"
          data-setting="ultraAccurateTechnology"
          onclick="toggleSetting('ultraAccurateTechnology')"
        />
      </span>
      <span>
        <label for="toggleAS2">accuracy song 2</label>
        <input
          type="checkbox"
          id="toggleAS2"
          data-setting="accuracySong2"
          onclick="toggleSetting('accuracySong2')"
        />
      </span>
    </div>
  </div>
  <div class="side-text">
    <p>accuratelinuxgraphs.com</p>
  </div>
</Layout>
