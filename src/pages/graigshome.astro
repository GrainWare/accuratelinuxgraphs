---
import "leaflet/dist/leaflet.css";
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Graig's Personal Website</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        color: #333;
        background: linear-gradient(
          90deg,
          rgba(255, 255, 247, 0),
          rgba(80, 150, 230, 0.6)
        );
        background-size: cover;
      }

      header {
        text-align: center;
        padding: 4rem 0;
        position: relative;
        overflow: hidden;
      }

      h1 {
        font-size: 5.75rem;
        line-height: 1;
        color: #e6394d;
        letter-spacing: -2px;
        text-shadow: 0 8px rgba(0, 0, 0, 0.3);
      }

      h1 span {
        display: block;
        width: 75%;
        margin-left: auto;
        margin-right: auto;
        font-weight: normal;
      }

      p.header-text {
        max-width: 800px;
        margin: 2rem auto 1.5rem auto;
        font-size: 1.7em;
        line-height: 1.4;
        color: #e6394d;
      }

      .container {
        width: 90%;
        max-width: 1280px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 5rem;
      }

      section {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(60vh - var(--navHeight));
      }

      .section-title {
        font-size: 3.25em;
        text-align: left;
        color: #e94d7a;
        margin-bottom: 1rem;
      }

      .facts-container {
        display: grid;
        gap: 16px;
      }

      .fact-card {
        background-color: rgba(250, 238, 254, 0.9);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: inset 0 0 70px rgba(0, 0, 0, 0.2);
      }

      .fact-card:hover {
        animation: float infinite;
        transform-origin: center bottom;
      }

      @keyframes float {
        0% {
          transform: translateY(0) rotateZ(-3deg);
          opacity: 1;
        }
        50% {
          transform: translateY(-8px) rotateZ(4.6deg);
          opacity: 0.75;
        }
        90% {
          transform: translateY(2px) rotateZ(-2.3deg);
        }
      }

      h2.fact-title {
        font-size: 1.75rem;
        margin-bottom: 0.6em;
        color: #e94d7a;
      }

      h2.fact-title::after {
        content: "·";
        display: inline-block;
        margin-left: 0.4em;
        font-weight: bold;
      }

      p.fact-description {
        line-height: 1.38;
        max-width: 50ch;
        text-align: center;
      }

      #map {
        height: 512px;
      }

      .about {
        display: flex;
        flex-direction: column;
      }
    </style>
    <script>
      import L from "leaflet";

      const map = L.map("map").setView([47.6038, -122.3395], 13);

      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution:
          '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      L.marker([47.6038, -122.3395])
        .addTo(map)
        .bindPopup(
          "<strong>My Home in Washington State</strong><br>I live in this house with my 5 children and my 12 grandchildren and my 2 dogs and my 1 cat and my 1 wonderful wife Cynthia who I love and cherish.",
        )
        .openPopup();
    </script>
  </head>
  <body>
    <div class="container">
      <header id="hero" style="--navHeight: 2rem;">
        <h1>Graig<span> of Washington State</span></h1>
        <p class="header-text">
          Welcome to my website, My name is graig I was born January 1st, 1990.
        </p>
        <h2><i>7,341.4 lives</i> changed for the better.</h2>
        <br />
        <h2><i>10 years</i> of service.</h2>
        <br />
        <h2><b><i>65 WPM</i></b> typing speed.</h2>
        <h1>I am Graig. The best person on planet earth.</h1>
      </header>

      <section class="about">
        <div class="section-title">ABOUT GRAIG</div>
        <div class="facts-container">
          <article class="fact-card">
            <h2 class="fact-title">When I was 6 my parents divorced</h2>
            <p class="fact-description" style="--radius:4px;">
              I was raised by my mom and stepdad. My mom is a retired
              schoolteacher and my stepdad a retired military officer.
            </p>
          </article>
          <article class="fact-card">
            <h2 class="fact-title">The tylenol incident</h2>
            <p class="fact-description" style="--radius:4px;">
